# ── The Vantage MCP Server — environment ──────────────────────────────────

# Transport: "http" (remote, Streamable HTTP) or "stdio" (local). Default: http
TRANSPORT=http

# Port for the HTTP transport. Default: 3000
PORT=3000

# The Vantage Supabase project URL (edge functions live under /functions/v1).
VANTAGE_SUPABASE_URL=https://tsvmyjxnvdrwcdesiewv.supabase.co

# Supabase anon (publishable) key — public, but read from env so it can rotate.
VANTAGE_SUPABASE_ANON_KEY=

# Fallback Vantage session token (a Supabase user JWT) for local/stdio runs.
# In production, clients should send this per-request via the
# `Authorization: Bearer <token>` or `x-vantage-token` header instead.
VANTAGE_TOKEN=
