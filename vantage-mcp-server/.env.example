# ── The Vantage MCP Server — environment ──────────────────────────────────

# Transport: "http" (remote, Streamable HTTP) or "stdio" (local). Default: http
TRANSPORT=http

# Port for the HTTP transport. Default: 3000
PORT=3000

# The Vantage Supabase project URL (edge functions live under /functions/v1).
VANTAGE_SUPABASE_URL=https://tsvmyjxnvdrwcdesiewv.supabase.co

# Supabase anon (publishable) key — public.
VANTAGE_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — SECRET. Stays on the host; never exposed to a
# connecting client. Required: the server uses it to resolve connector tokens,
# deduct credits, generate reels, and record submissions on the user's behalf.
VANTAGE_SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback connector token (vtg_live_…) for local/stdio testing.
# In production, each client sends its own token via the
# `Authorization: Bearer <token>` or `x-vantage-token` header instead.
VANTAGE_TOKEN=
